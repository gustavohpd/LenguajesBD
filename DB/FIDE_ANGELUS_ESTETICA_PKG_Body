PROCEDURE FIDE_SERVICIOS_OBTENER_TODOS_SP (
  p_cursor OUT SYS_REFCURSOR
)
IS
BEGIN
  OPEN p_cursor FOR
    SELECT 
      SERVICIO_ID,
      ESTADO_ID,
      CATEGORIA_ID,
      NOMBRE,
      DESCRIPCION,
      DURACION,
      PRECIO
    FROM FIDE_SERVICIOS_TB
    WHERE ESTADO_ID = 1  -- opcional, si quieres solo activos
