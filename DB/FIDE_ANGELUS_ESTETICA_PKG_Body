FUNCTION FIDE_CITAS_POR_DIA_FN(
    P_FECHA IN DATE
) RETURN NUMBER IS
    V_CANT NUMBER := 0;
BEGIN
    SELECT COUNT(*)
    INTO V_CANT
    FROM FIDE_CITAS_TB
    WHERE TRUNC(FECHA_HORA) = TRUNC(P_FECHA);

    RETURN V_CANT;

EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('No fue posible obtener las citas del día indicado');
        RETURN V_CANT;
END FIDE_CITAS_POR_DIA_FN;
